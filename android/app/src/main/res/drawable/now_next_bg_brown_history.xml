<?xml version="1.0" encoding="utf-8"?>
<!-- brownHistory 테마 몸체: 위쪽 광택 띠와 가장자리 테두리. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#5E4226"
                android:startColor="#A0784E" />
            <stroke
                android:width="1dp"
                android:color="#D4A96A" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="72dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
