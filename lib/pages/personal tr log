class SigCell {
  final String type; // '' | 'typed' | 'drawn'
  final String value;

  const SigCell({required this.type, required this.value});

  factory SigCell.empty() => const SigCell(type: '', value: '');

  bool get isSigned => type.isNotEmpty && value.isNotEmpty;
}

