class _TrainingLogItem {
  String id;
  DateTime createdAt;

  /// text | voice_draft | category | pdf | anatomy
  String inputMethod;

  /// 카드에 크게 보일 제목
  String title;

  /// 회원명 또는 세션명
  String name;

  String time;
  String type;
  String memo;

  /// 나중에 자동태그 붙일 때 사용
  List<String> tags;

  /// 음성 원문 보관용
  String rawVoiceText;

  // ✅ 서명/잠금
  SigCell trainerSig;
  SigCell customerSig;
  bool locked;

  // ✅ 자동 기록: 각 서명 시각 + 잠금 시각
  String trainerSignedDate;
