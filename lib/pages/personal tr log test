  Future<void> _handleInbodyScan() async {
    final ImageSource? source = await _showImageSourceSheet();
    if (source == null) {
      return;
    }

    final XFile? image = await _imagePicker.pickImage(
      source: source,
      imageQuality: 92,
    );

    if (image == null) {
      return;
    }

    setState(() {
      _isProcessingOcr = true;
    });

    try {
      final InbodyOcrDraft draft = await _runInbodyOcr(image);

      if (!mounted) {
        return;
      }

      setState(() {
        _isProcessingOcr = false;
      });

      await _showInbodyReviewSheet(draft);
    } catch (e) {
      if (!mounted) {
        return;
      }

      setState(() {
        _isProcessingOcr = false;
      });

      _showSnackBar('OCR 처리 중 오류가 발생했습니다: $e');
    }
  }

