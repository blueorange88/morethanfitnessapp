              IconButton(
                onPressed: () => _moveMonth(-1),
                icon: const Icon(Icons.chevron_left_rounded),
              ),
              Text(
                '${_focusedMonth.year}.${_focusedMonth.month.toString().padLeft(2, '0')}',
                style: const TextStyle(
                  fontWeight: FontWeight.w800,
                  color: Color(0xFF394152),
                ),
              ),
              IconButton(
                onPressed: () => _moveMonth(1),
                icon: const Icon(Icons.chevron_right_rounded),
              ),
            ],
          ),
          const SizedBox(height: 8),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: <Widget>[
              OutlinedButton.icon(
                onPressed: _selectFirstLessonDay,
                icon: const Icon(Icons.first_page_rounded, size: 18),
                label: const Text('처음 레슨일'),
                style: OutlinedButton.styleFrom(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(14),
                  ),
                ),
              ),
              OutlinedButton.icon(
                onPressed: _selectLastLessonDay,
                icon: const Icon(Icons.last_page_rounded, size: 18),
                label: const Text('마지막 레슨일'),
                style: OutlinedButton.styleFrom(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(14),
                  ),
                ),
              ),
              if (_selectedDate != null)
                OutlinedButton.icon(
                  onPressed: _clearSelectedDate,
                  icon: const Icon(Icons.layers_clear_rounded, size: 18),
                  label: const Text('전체 보기'),
                  style: OutlinedButton.styleFrom(
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 12),
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(14),
                    ),
                  ),
                ),
            ],
          ),
          const SizedBox(height: 14),
          Row(
            children: const <Widget>[
              _WeekdayLabel('일'),
              _WeekdayLabel('월'),
              _WeekdayLabel('화'),
              _WeekdayLabel('수'),
              _WeekdayLabel('목'),
              _WeekdayLabel('금'),
              _WeekdayLabel('토'),
            ],
          ),
          const SizedBox(height: 8),
          GridView.builder(
            itemCount: visibleDays.length,
            shrinkWrap: true,
            physics: const NeverScrollableScrollPhysics(),
            gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: 7,
              crossAxisSpacing: 8,
              mainAxisSpacing: 8,
              childAspectRatio: 0.82,
            ),
            itemBuilder: (context, index) {
              final DateTime? day = visibleDays[index];
              if (day == null) {
                return const SizedBox.shrink();
              }

              final bool hasRecord = _hasRecordOnDay(day);
              final bool isSelected =
                  _selectedDate != null && DateUtils.isSameDay(day, _selectedDate);
              final bool isToday = DateUtils.isSameDay(day, DateTime.now());

              return InkWell(
                borderRadius: BorderRadius.circular(14),
                onTap: () {
                  setState(() {
                    _selectedDate = day;
                  });
                },
                child: Ink(
                  decoration: BoxDecoration(
                    color: isSelected
                        ? const Color(0xFF6C63FF)
                        : hasRecord
                            ? const Color(0xFFFFF5F5)
                            : const Color(0xFFF7F8FC),
                    borderRadius: BorderRadius.circular(14),
                    border: Border.all(
                      color: isToday
                          ? const Color(0xFF3D8BFF)
                          : isSelected
                              ? const Color(0xFF6C63FF)
                              : const Color(0xFFE6EAF3),
                    ),
                  ),
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: <Widget>[
                      Text(
                        '${day.day}',
                        style: TextStyle(
                          fontWeight: FontWeight.w800,
                          color: isSelected ? Colors.white : const Color(0xFF2E374A),
                        ),
                      ),
                      const SizedBox(height: 6),
                      AnimatedOpacity(
                        duration: const Duration(milliseconds: 150),
                        opacity: hasRecord ? 1 : 0,
                        child: Container(
                          width: 7,
                          height: 7,
                          decoration: BoxDecoration(
