                                  borderRadius: BorderRadius.circular(16),
                                ),
                              ),
                              icon: const Icon(Icons.check_circle_outline_rounded),
                              label: const Text(
                                '검토값 적용',
                                style: TextStyle(
                                  fontSize: 15,
                                  fontWeight: FontWeight.w800,
                                ),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
              ),
            );
          },
        );
      },
    );

    dateController.dispose();
    weightController.dispose();
    muscleController.dispose();
    fatController.dispose();

    if (entry == null || !mounted) {
      return;
    }

    setState(() {
      _inbodyEntries.removeWhere((element) => DateUtils.isSameDay(element.date, entry.date));
      _inbodyEntries.add(entry);
      _inbodyEntries.sort((a, b) => a.date.compareTo(b.date));
      _focusedMonth = DateTime(entry.date.year, entry.date.month);
    });

    _showSnackBar('인바디 값이 적용되었습니다.');
  }

  void _showSnackBar(String message) {
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(message)),
    );
  }

  void _moveMonth(int offset) {
    setState(() {
      _focusedMonth = DateTime(_focusedMonth.year, _focusedMonth.month + offset, 1);
    });
  }

  void _selectFirstLessonDay() {
    if (_records.isEmpty) {
      return;
    }
    final LessonRecord oldest = _records.reduce(
      (value, element) => value.date.isBefore(element.date) ? value : element,
    );

    setState(() {
      _selectedDate = oldest.date;
      _focusedMonth = DateTime(oldest.date.year, oldest.date.month);
      _showCalendar = true;
    });
  }

  void _selectLastLessonDay() {
    if (_records.isEmpty) {
      return;
    }
    final LessonRecord latest = _records.reduce(
      (value, element) => value.date.isAfter(element.date) ? value : element,
    );

    setState(() {
      _selectedDate = latest.date;
      _focusedMonth = DateTime(latest.date.year, latest.date.month);
      _showCalendar = true;
    });
  }

  void _clearSelectedDate() {
    setState(() {
      _selectedDate = null;
    });
  }

