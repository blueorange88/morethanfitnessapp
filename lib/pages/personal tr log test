class _SimpleLineChartPainter extends CustomPainter {
  _SimpleLineChartPainter({
    required this.points,
    required this.lineColor,
    required this.pointColor,
    required this.gridColor,
    this.minY,
    this.maxY,
  });

  final List<LineChartPoint> points;
  final Color lineColor;
  final Color pointColor;
  final Color gridColor;
  final double? minY;
  final double? maxY;

  @override
  void paint(Canvas canvas, Size size) {
    if (points.isEmpty) {
      return;
    }

    const EdgeInsets padding = EdgeInsets.fromLTRB(10, 10, 10, 18);
    final double left = padding.left;
    final double right = size.width - padding.right;
    final double top = padding.top;
    final double bottom = size.height - padding.bottom;

    double minValue = minY ?? points.map((point) => point.value).reduce(math.min);
    double maxValue = maxY ?? points.map((point) => point.value).reduce(math.max);

    if (minValue == maxValue) {
      minValue -= 1;
      maxValue += 1;
    }

    final Paint gridPaint = Paint()
      ..color = gridColor
      ..strokeWidth = 1;

    for (int i = 0; i < 4; i++) {
      final double y = top + ((bottom - top) / 3) * i;
      canvas.drawLine(Offset(left, y), Offset(right, y), gridPaint);
    }

    final Path linePath = Path();
    final Path fillPath = Path();
    final List<Offset> offsets = <Offset>[];

    for (int i = 0; i < points.length; i++) {
      final double x = points.length == 1
          ? (left + right) / 2
          : left + (right - left) * (i / (points.length - 1));
      final double normalized = (points[i].value - minValue) / (maxValue - minValue);
      final double y = bottom - (bottom - top) * normalized;

      offsets.add(Offset(x, y));

      if (i == 0) {
        linePath.moveTo(x, y);
        fillPath.moveTo(x, bottom);
        fillPath.lineTo(x, y);
      } else {
        linePath.lineTo(x, y);
        fillPath.lineTo(x, y);
      }
    }

    fillPath.lineTo(offsets.last.dx, bottom);
    fillPath.close();

    final Paint fillPaint = Paint()
      ..shader = LinearGradient(
        begin: Alignment.topCenter,
        end: Alignment.bottomCenter,
        colors: <Color>[
          lineColor.withOpacity(0.22),
          lineColor.withOpacity(0.03),
        ],
      ).createShader(Rect.fromLTRB(left, top, right, bottom));

    canvas.drawPath(fillPath, fillPaint);

    final Paint linePaint = Paint()
      ..color = lineColor
      ..strokeWidth = 3
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round;

    canvas.drawPath(linePath, linePaint);

    final Paint pointPaint = Paint()..color = pointColor;
    for (final offset in offsets) {
      canvas.drawCircle(offset, 4.2, pointPaint);
      canvas.drawCircle(
        offset,
        7,
        Paint()
          ..color = pointColor.withOpacity(0.16)
          ..style = PaintingStyle.fill,
      );
    }
  }

  @override
  bool shouldRepaint(covariant _SimpleLineChartPainter oldDelegate) {
    return oldDelegate.points != points ||
        oldDelegate.lineColor != lineColor ||
        oldDelegate.pointColor != pointColor ||
        oldDelegate.gridColor != gridColor ||
        oldDelegate.minY != minY ||
        oldDelegate.maxY != maxY;
  }
}

