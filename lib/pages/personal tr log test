  Future<InbodyOcrDraft> _runInbodyOcr(XFile image) async {
    final InputImage inputImage = InputImage.fromFilePath(image.path);
    final RecognizedText recognizedText = await _textRecognizer.processImage(inputImage);

    return _parseInbodyText(
      rawText: recognizedText.text,
      imagePath: image.path,
    );
  }

  InbodyOcrDraft _parseInbodyText({
    required String rawText,
    required String imagePath,
  }) {
    final List<String> lines = rawText
        .split('\n')
        .map((line) => line.trim())
        .where((line) => line.isNotEmpty)
        .toList();

    double? weight = _extractMetricValue(
      lines: lines,
      keywords: const <String>['체중', '몸무게', 'weight'],
      min: 30,
      max: 180,
    );

    double? skeletalMuscle = _extractMetricValue(
      lines: lines,
      keywords: const <String>['골격근량', 'skeletal muscle', 'smm', '골격근'],
      min: 10,
      max: 80,
    );

    double? bodyFatMass = _extractMetricValue(
      lines: lines,
      keywords: const <String>['체지방량', 'body fat mass', 'body fat', '체지방'],
      min: 1,
      max: 80,
    );

    final List<double> broadCandidates = _extractAllNumbers(rawText)
        .where((value) => value >= 1 && value <= 180)
        .toList();

    if (weight == null) {
      weight = _firstMatchingNumber(
        broadCandidates,
        (value) => value >= 30 && value <= 180,
      );
    }

    if (skeletalMuscle == null) {
      skeletalMuscle = _firstMatchingNumber(
        broadCandidates,
        (value) => value >= 10 && value <= 80 && value != weight,
      );
    }

    if (bodyFatMass == null) {
      bodyFatMass = _firstMatchingNumber(
        broadCandidates,
        (value) =>
            value >= 1 &&
            value <= 80 &&
            value != weight &&
            value != skeletalMuscle,
      );
    }

    return InbodyOcrDraft(
      imagePath: imagePath,
      rawText: rawText,
      date: DateTime.now(),
      weight: weight,
      skeletalMuscle: skeletalMuscle,
      bodyFatMass: bodyFatMass,
    );
  }

  double? _extractMetricValue({
    required List<String> lines,
    required List<String> keywords,
    required double min,
    required double max,
  }) {
    for (int index = 0; index < lines.length; index++) {
      final String current = lines[index];
      final String next = index + 1 < lines.length ? lines[index + 1] : '';
      final String bundle = '$current $next'.toLowerCase();

      final bool hasKeyword = keywords.any(
        (keyword) => bundle.contains(keyword.toLowerCase()),
      );

      if (!hasKeyword) {
        continue;
      }

      final List<double> values = _extractAllNumbers('$current $next');
      for (final value in values) {
        if (value >= min && value <= max) {
          return value;
        }
      }
    }
    return null;
  }

  double? _firstMatchingNumber(
    List<double> values,
    bool Function(double value) test,
  ) {
    for (final double value in values) {
      if (test(value)) {
        return value;
      }
    }
    return null;
  }

  List<double> _extractAllNumbers(String text) {
    final Iterable<RegExpMatch> matches =
        RegExp(r'(\d{1,3}(?:[.,]\d{1,2})?)').allMatches(text);

    return matches
        .map((match) => match.group(0))
        .whereType<String>()
        .map((value) => value.replaceAll(',', '.'))
        .map(double.tryParse)
        .whereType<double>()
        .toList();
  }

