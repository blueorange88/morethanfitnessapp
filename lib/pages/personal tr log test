      _inbodyEntries.isNotEmpty ? _inbodyEntries.last : null;

  List<LessonRecord> get _filteredRecords {
    if (_selectedDate == null) {
      return List<LessonRecord>.from(_records);
    }

    return _records
        .where((record) => DateUtils.isSameDay(record.date, _selectedDate))
        .toList()
      ..sort((a, b) => b.date.compareTo(a.date));
  }

  List<LineChartPoint> get _performancePoints {
    final ascending = List<LessonRecord>.from(_records)
      ..sort((a, b) => a.date.compareTo(b.date));

    final start = ascending.length > 8 ? ascending.length - 8 : 0;
    final visible = ascending.sublist(start);

    return visible
        .map(
          (record) => LineChartPoint(
            label: '${record.date.month}/${record.date.day}',
            value: record.performanceScore,
          ),
        )
        .toList();
  }

  List<LineChartPoint> get _inbodyWeightPoints {
    final start = _inbodyEntries.length > 6 ? _inbodyEntries.length - 6 : 0;
    final visible = _inbodyEntries.sublist(start);

    return visible
        .map(
          (entry) => LineChartPoint(
            label: '${entry.date.month}/${entry.date.day}',
            value: entry.weight,
          ),
        )
        .toList();
  }

  List<LineChartPoint> get _lessonTrendPoints {
    final now = DateTime.now();
    final Map<String, int> countByMonth = <String, int>{};

    for (final record in _records) {
      final monthKey =
          '${record.date.year}-${record.date.month.toString().padLeft(2, '0')}';
      countByMonth[monthKey] = (countByMonth[monthKey] ?? 0) + 1;
    }

    final List<LineChartPoint> points = <LineChartPoint>[];
    for (int i = 5; i >= 0; i--) {
      final month = DateTime(now.year, now.month - i, 1);
      final key = '${month.year}-${month.month.toString().padLeft(2, '0')}';
      points.add(
        LineChartPoint(
          label: '${month.month}월',
          value: (countByMonth[key] ?? 0).toDouble(),
        ),
      );
    }
    return points;
  }

  int get _totalLessonCount => _records.length;

  double get _averagePerformance {
    if (_records.isEmpty) {
      return 0;
    }

    final sum = _records.fold<double>(
      0,
      (previousValue, element) => previousValue + element.performanceScore,
    );
    return sum / _records.length;
  }

  bool _hasRecordOnDay(DateTime day) {
    return _records.any((record) => DateUtils.isSameDay(record.date, day));
  }

