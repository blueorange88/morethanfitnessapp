      isDense: true,
    );

    return Padding(
      padding: const EdgeInsets.fromLTRB(12, 8, 12, 0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Wrap(
            runSpacing: 8,
            spacing: 8,
            children: [
              _w(260, TextField(controller: _name, decoration: deco('이름'))),
              _w(
                160,
                TextField(
                  controller: _birth,
                  decoration: deco('생년월일 (YYYY-MM-DD)'),
                  keyboardType: TextInputType.number,
                  onChanged: (s) => setState(() => _birth.text = _formatBirth(s)),
                ),
              ),
              _w(
                200,
                TextField(
                  controller: _phone,
                  decoration: deco('연락처'),
                  keyboardType: TextInputType.phone,
                  onChanged: (s) => setState(() => _phone.text = _formatPhone(s)),
                ),
