class TrainingLogConsentPage extends StatefulWidget {
  const TrainingLogConsentPage({
    super.key,
    this.memberId,
    this.memberName,
    this.trainerName,
    this.memberPhone,
  });

  final String? memberId;
  final String? memberName;
  final String? trainerName;
  final String? memberPhone;

  @override
  State<TrainingLogConsentPage> createState() => _TrainingLogConsentPageState();
}

class _TrainingLogConsentPageState extends State<TrainingLogConsentPage> {
  static const resetPin = '0000';
  static const storePrefix = 'mtf_pt_log_v6';

  final _name = TextEditingController();
  final _birth = TextEditingController();
  final _phone = TextEditingController();
  final _lesson = TextEditingController();
  final _trainer = TextEditingController();
  final _start = TextEditingController();
  final _page = TextEditingController(text: '1');

  final _consentDateC = TextEditingController();
  final _consentTimeC = TextEditingController();

  final Map<int, TextEditingController> _dateCtrls = {};
  final Map<int, TextEditingController> _timeCtrls = {};

  /* Firebase */
  StreamSubscription<fa.User?>? _authSub;
  bool _firebaseReady = false;

  TextEditingController _ctrlFor(Map<int, TextEditingController> map, int key, String init) {
    return map.putIfAbsent(key, () => TextEditingController(text: init));
  }

  String get _storeKey {
    final idPart = (widget.memberId ?? _digits(_phone.text));
    final page = _page.text.isEmpty ? '1' : _page.text;
    return '$storePrefix::${idPart.isEmpty ? 'anon' : idPart}::p$page';
  }

  DocumentReference<Map<String, dynamic>>? get _cloudDoc {
    final id = widget.memberId;
    if (id == null || id.isEmpty) return null;
    final page = _page.text.isEmpty ? '1' : _page.text;
    return FirebaseFirestore.instance
        .collection('members')
        .doc(id)
        .collection('training_logs')
        .doc('p$page');
  }

  PageData data = PageData();

  String lastTrainerTyped = '';
  String lastCustomerTyped = '';

  @override
  void initState() {
    super.initState();
    if ((widget.memberName ?? '').isNotEmpty) _name.text = widget.memberName!;
    if ((widget.trainerName ?? '').isNotEmpty) _trainer.text = widget.trainerName!;
    if ((widget.memberPhone ?? '').isNotEmpty) _phone.text = _formatPhone(widget.memberPhone!);

    for (final c in [_name, _birth, _phone, _lesson, _trainer, _start, _page]) {
      c.addListener(_autoSave);
    }
    _consentDateC.addListener(() {
      data.consent.date = _consentDateC.text;
      _autoSave();
    });
    _consentTimeC.addListener(() {
      data.consent.time = _consentTimeC.text;
      _autoSave();
    });

    WidgetsBinding.instance.addPostFrameCallback((_) async {
      await _ensureFirebaseAndAuth();
      await _loadFromLocal();
    });
  }

  @override
  void dispose() {
    _authSub?.cancel();
    for (final c in [_name, _birth, _phone, _lesson, _trainer, _start, _page]) {
      c.dispose();
    }
    _consentDateC.dispose();
    _consentTimeC.dispose();
    super.dispose();
  }

  /* Firebase Init/Auth */
  Future<void> _ensureFirebaseAndAuth() async {
    try {
      try {
        Firebase.app();
      } catch (_) {
        await Firebase.initializeApp(
          options: DefaultFirebaseOptions.currentPlatform,
        );
      }
      final auth = fa.FirebaseAuth.instance;
      _authSub = auth.authStateChanges().listen((u) async {
        if (u == null) {
          try {
            await auth.signInAnonymously();
          } catch (e) {
            if (!mounted) return;
            _toast(context, '익명 로그인 실패: $e');
          }
        }
        if (!mounted) return;
        setState(() => _firebaseReady = true);
      });
    } catch (e) {
      if (!mounted) return;
      _toast(context, 'Firebase 초기화 실패: $e');
    }
  }

  /* 저장/복원 */
  Future<void> _autoSave() async {
    data
      ..name = _name.text
      ..birth = _formatBirth(_birth.text)
      ..phone = _formatPhone(_phone.text)
      ..lesson = _lesson.text
      ..trainer = _trainer.text
      ..start = _start.text
      ..page = _page.text.isEmpty ? '1' : _page.text;

    final prefs = await SharedPreferences.getInstance();
    await prefs.setString(_storeKey, jsonEncode(data.toJson()));
  }

  Future<void> _loadFromLocal() async {
    final prefs = await SharedPreferences.getInstance();
    String? raw = prefs.getString(_storeKey);
    raw ??= prefs.getString(storePrefix); // 구버전 호환

    if (raw != null) {
      final j = jsonDecode(raw) as Map<String, dynamic>;
      data = PageData.fromJson(j);
      _applyMetaToControllers();
      _syncConsentControllers();
      setState(() {});
    } else {
      if (data.consent.date.isEmpty) data.consent.date = _todayIso();
      _syncConsentControllers();
      setState(() {});
    }
  }

  Future<void> _loadFromCloud() async {
    if (!_firebaseReady || _cloudDoc == null) {
      _toast(context, '클라우드 준비 중이거나 회원ID가 없습니다');
      return;
    }
    try {
      final snap = await _cloudDoc!.get();
      if (!snap.exists) {
        _toast(context, '클라우드에 저장된 내용이 없습니다');
        return;
      }
      final j = snap.data()!;
      final payload = (j['data'] is Map) ? (j['data'] as Map).cast<String, dynamic>() : j;
      data = PageData.fromJson(payload);
      _applyMetaToControllers();
      _syncConsentControllers();
      await _autoSave();
      if (mounted) setState(() {});
      _toast(context, '클라우드에서 불러왔습니다');
    } catch (e) {
      _toast(context, '클라우드 불러오기 실패: $e');
    }
  }

  Future<void> _saveToCloud() async {
    if (!_firebaseReady || _cloudDoc == null) {
      _toast(context, '클라우드 준비 중이거나 회원ID가 없습니다');
      return;
    }
    try {
      final db = FirebaseFirestore.instance;
      final now = FieldValue.serverTimestamp();
      final docRef = _cloudDoc!;
      final membersRef = db.collection('members').doc(widget.memberId);
      final cardRef = membersRef.collection('client_card').doc('v1');

      final batch = db.batch();
      batch.set(
        docRef,
        {
          'data': data.toJson(),
          'memberId': widget.memberId,
          'page': data.page,
          'updatedAt': now,
        },
        SetOptions(merge: true),
      );
      batch.set(membersRef, {'lastLogAt': now}, SetOptions(merge: true));
      batch.set(cardRef, {'lastLogAt': now}, SetOptions(merge: true));

      await batch.commit();
      _toast(context, '클라우드 저장 완료');
    } catch (e) {
      _toast(context, '클라우드 저장 실패: $e');
    }
  }

  Future<void> _applyNoshowDeductToSessions() async {
    if (!kAutoDecrementOnNoshow || !_firebaseReady || widget.memberId == null) return;
    try {
      final db = FirebaseFirestore.instance;
      final ref = db.collection('members').doc(widget.memberId);
      final cardRef = ref.collection('client_card').doc('v1');
      await db.runTransaction((tx) async {
        final snap = await tx.get(ref);
        final d = snap.data() as Map<String, dynamic>? ?? {};
        final sessions = (d['sessions'] as Map<String, dynamic>?) ?? {};
        final remain = (sessions['remain'] as num?)?.toInt() ?? 0;
        final total = (sessions['total'] as num?)?.toInt() ?? 0;
        final newRemain = (remain - 1) < 0 ? 0 : (remain - 1);

        tx.set(
          ref,
          {
            'sessions': {
              'total': total,
              'remain': newRemain,
              'done': (total - newRemain).clamp(0, total),
              'notRegistered': false,
            }
          },
          SetOptions(merge: true),
        );
        tx.set(
          cardRef,
          {
            'sessions': {
              'total': total,
              'remain': newRemain,
              'done': (total - newRemain).clamp(0, total),
            },
            'updatedAt': FieldValue.serverTimestamp(),
          },
          SetOptions(merge: true),
        );
      });
    } catch (_) {}
  }

  void _applyMetaToControllers() {
    _name.text = data.name;
    _birth.text = data.birth;
    _phone.text = data.phone;
    _lesson.text = data.lesson;
    _trainer.text = data.trainer;
    _start.text = data.start;
    _page.text = data.page.isEmpty ? '1' : data.page;
  }

  void _syncConsentControllers() {
    _consentDateC.text = data.consent.date;
    _consentTimeC.text = data.consent.time;
  }

  /* 유틸 */
  String _digits(String s) => s.replaceAll(RegExp(r'\D'), '');
  String _todayIso() {
    final now = DateTime.now();
    final d = DateTime(now.year, now.month, now.day);
    return d.toIso8601String().substring(0, 10);
  }

  String _formatPhone(String raw) {
    final v = _digits(raw);
    if (v.length <= 3) return v;
    if (v.length <= 7) return '${v.substring(0, 3)}-${v.substring(3)}';
    return '${v.substring(0, 3)}-${v.substring(3, 7)}-${v.substring(7, math.min(11, v.length))}';
  }

  String _formatBirth(String raw) {
    final only = _digits(raw);
    final v = only.substring(0, math.min(8, only.length));
    if (v.length <= 4) return v;
    if (v.length <= 6) return '${v.substring(0, 4)}-${v.substring(4)}';
    return '${v.substring(0, 4)}-${v.substring(4, 6)}-${v.substring(6, 8)}';
  }

  void _toast(BuildContext context, String msg) {
    ScaffoldMessenger.of(context).hideCurrentSnackBar();
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(msg), duration: const Duration(milliseconds: 1400)),
    );
  }

  /* 서명/노쇼 */
  Future<void> _openSignatureSheet({
    required BuildContext context,
    required String role, // 'trainer' | 'customer'
    required void Function(SigCell) onApply,
    SigCell? initial,
    bool isConsent = false,
  }) async {
    final typedController =
    TextEditingController(text: role == 'trainer' ? lastTrainerTyped : lastCustomerTyped);

    final result = await showModalBottomSheet<SigCell>(
      context: context,
      isScrollControlled: true,
      builder: (_) => SignatureSheet(
        title: '${isConsent ? "사인지 - " : ""}${role == "trainer" ? "트레이너" : "고객"} 서명',
        initial: initial,
        typedController: typedController,
      ),
    );

    if (result != null) {
      if (result.type == 'typed') {
        if (role == 'trainer') {
          lastTrainerTyped = result.value;
        } else {
          lastCustomerTyped = result.value;
        }
      }
      onApply(result);
      await _autoSave();
      if (mounted) setState(() {});
    }
  }

  Future<void> _openNoShowSheet(LogRow row) async {
    final res = await showModalBottomSheet<String>(
      context: context,
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            const ListTile(title: Text('노쇼 / 기타')),
            const Divider(height: 1),
            ListTile(
              leading: const Icon(Icons.remove_circle_outline),
              title: const Text('노쇼(차감) 처리'),
              onTap: () => Navigator.pop(context, 'deduct'),
            ),
            ListTile(
              leading: const Icon(Icons.do_not_disturb_on_outlined),
              title: const Text('노쇼(미차감) 처리'),
              onTap: () => Navigator.pop(context, 'undeduct'),
            ),
            if (row.noShowType != null)
              ListTile(
                leading: const Icon(Icons.lock_open),
                title: const Text('노쇼 취소 (PIN)'),
                onTap: () => Navigator.pop(context, 'cancel'),
              ),
            const SizedBox(height: 6),
          ],
        ),
      ),
    );

    if (res == null) return;

    if (res == 'cancel') {
      final pin = await _askPin();
      if (pin != resetPin) {
        _toast(context, 'PIN이 올바르지 않습니다');
        return;
      }
      row.noShowType = null;
      final bothSigned = row.trainer.isSigned && row.customer.isSigned;
      row.locked = bothSigned;
      _toast(context, '노쇼 취소 완료');
    } else {
      row.noShowType = res; // deduct | undeduct
      row.locked = true;
      if (res == 'deduct') {
        await _applyNoshowDeductToSessions();
      }
      _toast(context, '노쇼 처리 완료');
    }
    await _autoSave();
    if (mounted) setState(() {});
  }

  Future<String?> _askPin() async {
    final c = TextEditingController();
    return showDialog<String>(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('PIN 입력'),
        content: TextField(
          controller: c,
          obscureText: true,
          decoration: const InputDecoration(hintText: '기본 0000'),
        ),
        actions: [
          TextButton(onPressed: () => Navigator.pop(context), child: const Text('취소')),
          ElevatedButton(onPressed: () => Navigator.pop(context, c.text), child: const Text('확인')),
        ],
      ),
    );
  }

  /* 위젯 */
  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final muted = theme.textTheme.bodySmall?.copyWith(color: Colors.grey[600]);

    return WillPopScope(
      onWillPop: () async {
        // 뒤로가기 시 포커스 해제 + 안전 종료
        FocusScope.of(context).unfocus();
        return true;
      },
      child: Scaffold(
        appBar: AppBar(
          title: const Text('개인 / 트레이닝 일지 (통합)'),
          leading: IconButton(
            icon: const Icon(Icons.arrow_back),
            onPressed: () => Navigator.maybePop(context),
          ),
          actions: [
            IconButton(
              tooltip: '클라우드 불러오기',
              icon: const Icon(Icons.cloud_download_outlined),
              onPressed: _loadFromCloud,
            ),
            IconButton(
              tooltip: '클라우드 저장',
              icon: const Icon(Icons.cloud_upload_outlined),
              onPressed: _saveToCloud,
            ),
            IconButton(
              tooltip: '전체 초기화',
              icon: const Icon(Icons.restart_alt),
              onPressed: () async {
                final pin = await _askPin();
                if (pin != resetPin) {
                  _toast(context, '비밀번호가 일치하지 않습니다');
                  return;
                }
                final ok = await showDialog<bool>(
                  context: context,
                  builder: (_) => AlertDialog(
                    title: const Text('전체 초기화'),
                    content: const Text('모든 내용을 초기화할까요? (되돌릴 수 없음)'),
                    actions: [
                      TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('취소')),
                      ElevatedButton(onPressed: () => Navigator.pop(context, true), child: const Text('초기화')),
                    ],
                  ),
                );
                if (ok != true) return;

                final prefs = await SharedPreferences.getInstance();
                final keys =
                prefs.getKeys().where((k) => k == storePrefix || k.startsWith('$storePrefix::')).toList();
                for (final k in keys) {
                  await prefs.remove(k);
                }
                data = PageData();
                _name.clear();
                _birth.clear();
                _phone.clear();
                _lesson.clear();
                _trainer.clear();
                _start.clear();
                _page.text = '1';
                _syncConsentControllers();
                if (mounted) setState(() {});
                _autoSave();
                _toast(context, '초기화 완료');
              },
            ),
          ],
        ),
        body: SafeArea(
          child: Column(
            children: [
              _metaSection(muted),
              const SizedBox(height: 8),
              Expanded(child: _tableSection()),
              const SizedBox(height: 8),
              _consentSection(),
              const SizedBox(height: 8),
              _footerButtons(),
            ],
          ),
        ),
      ),
    );
  }

