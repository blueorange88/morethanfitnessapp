  Widget _sigView(SigCell cell) {
    if (cell.type == 'drawn' && cell.value.isNotEmpty) {
      return Image.memory(_dataUrlToBytes(cell.value), height: 56, fit: BoxFit.contain);
    }
    if (cell.type == 'typed' && cell.value.isNotEmpty) {
      return Row(mainAxisSize: MainAxisSize.min, children: [
        const Text('✍ ', style: TextStyle(fontSize: 16)),
        Text(cell.value, style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
      ]);
    }
    return const Text('아직 서명이 없습니다', style: TextStyle(color: Colors.grey));
  }

  Uint8List _dataUrlToBytes(String dataUrl) {
    final comma = dataUrl.indexOf(',');
    final base64Part = (comma >= 0) ? dataUrl.substring(comma + 1) : dataUrl;
    return Uint8List.fromList(base64Decode(base64Part));
  }
