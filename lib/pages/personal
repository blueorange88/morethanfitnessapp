class SigCell {
  final String type; // '' | 'typed' | 'drawn'
  final String value;
  const SigCell({required this.type, required this.value});
  factory SigCell.empty() => const SigCell(type: '', value: '');
  Map<String, dynamic> toJson() => {'type': type, 'value': value};
  factory SigCell.fromJson(Map<String, dynamic> j) =>
      SigCell(type: (j['type'] ?? '') as String, value: (j['value'] ?? '') as String);
  bool get isSigned => type.isNotEmpty && value.isNotEmpty;
}

extension SigCellCopy on SigCell {
  SigCell copyWith({String? type, String? value}) =>
      SigCell(type: type ?? this.type, value: value ?? this.value);
}

class LogRow {
  final int n;
  String date; // YYYY-MM-DD
  String time; // HH:MM
  String note;
  SigCell trainer;
  SigCell customer;
  bool locked;
  String? noShowType; // 'deduct' | 'undeduct' | null

  LogRow({
    required this.n,
    this.date = '',
    this.time = '08:00',
    this.note = '',
    SigCell? trainer,
    SigCell? customer,
    this.locked = false,
    this.noShowType,
  })  : trainer = trainer ?? SigCell.empty(),
        customer = customer ?? SigCell.empty();

  Map<String, dynamic> toJson() => {
    'n': n,
    'date': date,
    'time': time,
    'note': note,
    'trainer': trainer.toJson(),
    'customer': customer.toJson(),
    'locked': locked,
    'nsType': noShowType ?? '',
  };

  factory LogRow.fromJson(Map<String, dynamic> j) => LogRow(
    n: (j['n'] as num).toInt(),
    date: (j['date'] ?? '') as String,
    time: (j['time'] ?? '08:00') as String,
    note: (j['note'] ?? '') as String,
    trainer: SigCell.fromJson((j['trainer'] as Map?)?.cast<String, dynamic>() ?? const {}),
    customer: SigCell.fromJson((j['customer'] as Map?)?.cast<String, dynamic>() ?? const {}),
    locked: j['locked'] == true,
    noShowType: (() {
      final s = (j['nsType'] ?? '') as String;
      return s.isEmpty ? null : s;
    })(),
  );
}

class Consent {
  Consent();
  bool risk = false;
  bool privacy = false;
  bool photo = false;
  bool policy = false;
  SigCell trainer = SigCell.empty();
  SigCell customer = SigCell.empty();
  String date = '';
  String time = '09:00';
  bool locked = false;

  Map<String, dynamic> toJson() => {
    'checks': {'risk': risk, 'privacy': privacy, 'photo': photo, 'policy': policy},
    'trainer': trainer.toJson(),
    'customer': customer.toJson(),
    'date': date,
    'time': time,
    'locked': locked,
  };

  factory Consent.fromJson(Map<String, dynamic> j) {
    final c = Consent();
    final checks = (j['checks'] as Map?)?.cast<String, dynamic>() ?? const {};
    c
      ..risk = checks['risk'] == true
      ..privacy = checks['privacy'] == true
      ..photo = checks['photo'] == true
      ..policy = checks['policy'] == true
      ..trainer = SigCell.fromJson((j['trainer'] as Map?)?.cast<String, dynamic>() ?? const {})
      ..customer = SigCell.fromJson((j['customer'] as Map?)?.cast<String, dynamic>() ?? const {})
      ..date = (j['date'] ?? '') as String
      ..time = (j['time'] ?? '09:00') as String
      ..locked = j['locked'] == true;
    return c;
  }
}

class PageData {
  PageData();
  String name = '';
  String birth = '';
  String phone = '';
  String lesson = '';
  String trainer = '';
  String start = '';
  String page = '1';
  List<LogRow> rows = List.generate(30, (i) => LogRow(n: i + 1));
  Consent consent = Consent();

  Map<String, dynamic> toJson() => {
    'meta': {
      'name': name,
      'birth': birth,
      'phone': phone,
      'lesson': lesson,
      'trainer': trainer,
      'start': start,
      'page': page,
    },
    'rows': rows.map((e) => e.toJson()).toList(),
    'consent': consent.toJson(),
  };

  factory PageData.fromJson(Map<String, dynamic> j) {
    final p = PageData();
    final m = (j['meta'] as Map?)?.cast<String, dynamic>() ?? const {};
    p
      ..name = (m['name'] ?? '') as String
      ..birth = (m['birth'] ?? '') as String
      ..phone = (m['phone'] ?? '') as String
      ..lesson = (m['lesson'] ?? '') as String
      ..trainer = (m['trainer'] ?? '') as String
      ..start = (m['start'] ?? '') as String
      ..page = (m['page']?.toString() ?? '1');

    final rowsJson = (j['rows'] as List?)?.cast<Map>() ?? const [];
    if (rowsJson.isNotEmpty) {
      p.rows = rowsJson.map((e) => LogRow.fromJson(e.cast<String, dynamic>())).toList();
      if (p.rows.length < 30) {
        final base = p.rows.length;
        p.rows.addAll(List.generate(30 - base, (i) => LogRow(n: base + i + 1)));
      }
    }
    if (j['consent'] != null) {
      p.consent = Consent.fromJson((j['consent'] as Map).cast<String, dynamic>());
    }
    return p;
  }
}

