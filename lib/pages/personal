/* ==============================
 * 서명 바텀시트
 * ============================ */
class SignatureSheet extends StatefulWidget {
  final String title;
  final SigCell? initial;
  final TextEditingController typedController;

  const SignatureSheet({super.key, required this.title, this.initial, required this.typedController});

  @override
  State<SignatureSheet> createState() => _SignatureSheetState();
}

class _SignatureSheetState extends State<SignatureSheet> with SingleTickerProviderStateMixin {
  late TabController tab;
  final repaintKey = GlobalKey();
  final canvasKey = GlobalKey<_SimpleSignatureCanvasState>();

  @override
  void initState() {
    super.initState();
    tab = TabController(length: 2, vsync: this);
  }

  @override
  void dispose() {
    tab.dispose();
    super.dispose();
  }

  Future<String?> _exportPngDataUrl() async {
    final boundary = repaintKey.currentContext?.findRenderObject() as RenderRepaintBoundary?;
    if (boundary == null) return null;
    final img = await boundary.toImage(pixelRatio: 2.0);
    final bytes = await img.toByteData(format: ui.ImageByteFormat.png);
    if (bytes == null) return null;
    final b64 = base64Encode(bytes.buffer.asUint8List());
    return 'data:image/png;base64,$b64';
  }

  @override
  Widget build(BuildContext context) {
    return SafeArea(
      child: Padding(
        padding: EdgeInsets.only(bottom: MediaQuery.of(context).viewInsets.bottom),
        child: DraggableScrollableSheet(
          expand: false,
          initialChildSize: 0.7,
          builder: (context, controller) {
            return Material(
              elevation: 8,
              borderRadius: const BorderRadius.vertical(top: Radius.circular(16)),
              child: Column(
                children: [
                  ListTile(
                    title: Text(widget.title, style: const TextStyle(fontWeight: FontWeight.w700)),
                    trailing: IconButton(icon: const Icon(Icons.close), onPressed: () => Navigator.pop(context)),
                  ),
                  TabBar(controller: tab, tabs: const [Tab(text: '타이핑'), Tab(text: '손글씨')]),
                  Expanded(
                    child: TabBarView(
                      controller: tab,
                      children: [
                        // 타이핑 탭
                        Padding(
                          padding: const EdgeInsets.all(12),
                          child: Column(
                            children: [
                              TextField(
                                controller: widget.typedController,
                                decoration: const InputDecoration(hintText: '이름(서명 표기)', border: OutlineInputBorder()),
                              ),
                              const SizedBox(height: 12),
                              const Align(alignment: Alignment.centerLeft, child: Text('미리보기:', style: TextStyle(color: Colors.grey))),
                              const SizedBox(height: 6),
                              ValueListenableBuilder<TextEditingValue>(
                                valueListenable: widget.typedController,
                                builder: (_, v, __) {
                                  return Container(
                                    alignment: Alignment.centerLeft,
                                    padding: const EdgeInsets.all(12),
                                    width: double.infinity,
                                    decoration: BoxDecoration(border: Border.all(color: Colors.grey), borderRadius: BorderRadius.circular(8)),
                                    child: Row(mainAxisSize: MainAxisSize.min, children: [
                                      const Text('✍ ', style: TextStyle(fontSize: 16)),
                                      Flexible(child: Text(v.text, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w600))),
                                    ]),
                                  );
                                },
                              ),
                            ],
                          ),
                        ),
                        // 손글씨 탭
                        Padding(
                          padding: const EdgeInsets.all(12),
                          child: Column(
                            children: [
                              RepaintBoundary(
                                key: repaintKey,
                                child: Container(
                                  decoration: BoxDecoration(border: Border.all(color: Colors.grey.shade400), borderRadius: BorderRadius.circular(10)),
                                  child: SimpleSignatureCanvas(key: canvasKey, height: 180, strokeWidth: 2.5),
                                ),
                              ),
                              const SizedBox(height: 8),
                              Row(children: [const Spacer(), OutlinedButton(onPressed: () => canvasKey.currentState?.clear(), child: const Text('지우기'))]),
                            ],
                          ),
                        ),
                      ],
                    ),
                  ),
                  const Divider(height: 1),
                  Padding(
                    padding: const EdgeInsets.all(12),
                    child: Row(
                      children: [
                        OutlinedButton(onPressed: () => Navigator.pop(context), child: const Text('취소')),
                        const Spacer(),
                        ElevatedButton(
                          onPressed: () async {
                            if (tab.index == 0) {
                              final name = widget.typedController.text.trim();
                              if (name.isEmpty) return;
                              Navigator.pop(context, SigCell(type: 'typed', value: name));
                            } else {
                              final drift = canvasKey.currentState?.hasStroke == true;
                              if (!drift) return;
                              final dataUrl = await _exportPngDataUrl();
                              if (dataUrl == null) return;
                              Navigator.pop(context, SigCell(type: 'drawn', value: dataUrl));
                            }
                          },
                          child: const Text('적용'),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            );
          },
        ),
      ),
    );
  }
}

/* ==============================
 * 아주 단순한 서명 캔버스
 * ============================ */
class SimpleSignatureCanvas extends StatefulWidget {
  final double height;
  final double strokeWidth;
  const SimpleSignatureCanvas({super.key, required this.height, required this.strokeWidth});

  @override
  State<SimpleSignatureCanvas> createState() => _SimpleSignatureCanvasState();
}

class _SimpleSignatureCanvasState extends State<SimpleSignatureCanvas> {
  final List<List<Offset>> _paths = [];
  bool get hasStroke => _paths.any((p) => p.length > 1);

  void clear() => setState(() => _paths.clear());

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      height: widget.height,
      width: double.infinity, // 부모가 준 가로 제약 안에서만 확장
      child: GestureDetector(
        onPanStart: (d) => setState(() => _paths.add([d.localPosition])),
        onPanUpdate: (d) => setState(() => _paths.last.add(d.localPosition)),
        child: CustomPaint(
          painter: _SigPainter(paths: _paths, stroke: widget.strokeWidth),
          // ✅ size 지정하지 않음: SizedBox가 크기를 정해줍니다.
        ),
      ),
    );
  }
}

class _SigPainter extends CustomPainter {
  final List<List<Offset>> paths;
  final double stroke;
  _SigPainter({required this.paths, required this.stroke});

  @override
  void paint(Canvas canvas, Size size) {
    final bg = Paint()..color = Colors.white;
    canvas.drawRect(Offset.zero & size, bg);

    final p = Paint()
      ..color = Colors.black
      ..strokeWidth = stroke
      ..style = PaintingStyle.stroke
      ..strokeCap = StrokeCap.round
      ..strokeJoin = StrokeJoin.round;

    for (final path in paths) {
      if (path.length < 2) continue;
      final dp = Path()..moveTo(path.first.dx, path.first.dy);
      for (int i = 1; i < path.length; i++) {
        dp.lineTo(path[i].dx, path[i].dy);
      }
      canvas.drawPath(dp, p);
    }
  }

  @override
  bool shouldRepaint(covariant _SigPainter old) => old.paths != paths || old.stroke != stroke;
}
